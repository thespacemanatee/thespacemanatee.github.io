---
// Animated SVG wave ported from the original cara contact section.
// Uses native SVG <animate>, no JavaScript.
---

<div class="absolute bottom-0 w-full" style="transform: matrix(1, 0, 0, -1, 0, 0);">
  <div class="relative h-full">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      id="contact-wave"
      viewBox="0 0 800 338.05"
      preserveAspectRatio="none"
      class="block w-full"
      style="height: 40vh;"
      aria-hidden="true"
    >
      <path fill="var(--color-divider)">
        <animate
          attributeName="d"
          values="M 0 100 Q 250 50 400 200 Q 550 350 800 300 L 800 0 L 0 0 L 0 100 Z;
                  M 0 100 Q 200 150 400 200 Q 600 250 800 300 L 800 0 L 0 0 L 0 100 Z;
                  M 0 100 Q 150 350 400 200 Q 650 50 800 300 L 800 0 L 0 0 L 0 100 Z"
          repeatCount="indefinite"
          dur="30s"
        />
      </path>
    </svg>
  </div>
</div>
