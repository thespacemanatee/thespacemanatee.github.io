---
import ParallaxLayer from '@/components/ParallaxLayer.astro';
import Shapes from '@/components/Shapes.astro';
---

<section id="hero" class="relative min-h-screen overflow-hidden">
  {/* Background layer: large decorative shapes */}
  <ParallaxLayer speed={-0.4} class="pointer-events-none absolute inset-0">
    <Shapes icon="circle" width={64} color="icon-green" left="95%" top="5%" />
    <Shapes icon="box" width={64} color="icon-purple" left="5%" top="90%" hiddenMobile />
    <Shapes icon="circle" width={24} color="icon-darker" left="5%" top="70%" hiddenMobile />
  </ParallaxLayer>

  {/* Mid layer: floating shapes */}
  <ParallaxLayer speed={0.2} class="pointer-events-none absolute inset-0">
    <Shapes icon="triangle" width={48} stroke color="icon-orange" left="10%" top="20%" hiddenMobile motion="up-down" />
    <Shapes icon="hexa" width={48} stroke color="icon-red" left="60%" top="70%" motion="up-down" />
    <Shapes icon="box" width={6} color="icon-darker" left="60%" top="15%" motion="up-down" />
    <Shapes icon="arrow" width={16} color="icon-blue" left="80%" top="10%" hiddenMobile motion="up-down-wide" />
    <Shapes icon="triangle" width={12} stroke color="icon-brightest" left="90%" top="50%" motion="up-down-wide" />
    <Shapes icon="circle" width={16} color="icon-darker" left="70%" top="90%" motion="up-down-wide" />
    <Shapes icon="triangle" width={16} stroke color="icon-darkest" left="30%" top="65%" motion="up-down-wide" />
    <Shapes icon="cross" width={16} stroke color="icon-pink" left="28%" top="15%" motion="up-down-wide" />
    <Shapes icon="circle" width={6} color="icon-darkest" left="75%" top="10%" motion="up-down-wide" />
    <Shapes icon="up-down" width={8} color="icon-darkest" left="45%" top="10%" hiddenMobile motion="up-down-wide" />
    <Shapes icon="hexa" width={16} stroke color="icon-darker" left="10%" top="50%" />
    <Shapes icon="hexa" width={8} stroke color="icon-darker" left="80%" top="70%" />
  </ParallaxLayer>

  {/* Foreground content */}
  <ParallaxLayer speed={0.6} class="relative z-10 flex min-h-screen items-center justify-center px-6">
    <div class="max-w-3xl text-center">
      {/* TODO: refresh intro copy — written in 2022 */}
      <h2 class="reveal-down text-2xl font-semibold tracking-wide text-(--color-text-muted) md:text-3xl">
        Hello World!
      </h2>
      <h1 class="reveal-down mt-3 text-5xl font-bold leading-tight md:text-7xl">
        My name is Chee Kit
      </h1>
      <p class="reveal-down mt-6 text-xl text-(--color-text-muted) md:text-2xl">
        I'm a software developer (and so much more).
      </p>
      <a
        href="#projects"
        class="reveal-left mt-10 inline-block rounded-lg bg-(--color-divider) px-6 py-4 font-bold text-(--color-text) transition-all duration-500 hover:-translate-y-1 hover:bg-(--color-icon-red) hover:text-white hover:shadow-xl"
      >
        Find out why!
      </a>
    </div>
  </ParallaxLayer>
</section>
